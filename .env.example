# ---------------------------------------------------------------------------
# LinkFlow URL environment example
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Never prefix a secret with EXPO_PUBLIC_: those values are bundled into the app.
# ---------------------------------------------------------------------------

# Clerk publishable key (client-safe). Required.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional explicit backend URL.
# Usually NOT needed in development: the app derives the API host from the Expo
# dev-server address (LAN IP for physical devices, 10.0.2.2 for Android
# emulators, localhost for iOS simulators and web).
# REQUIRED for production builds and whenever Expo runs with --tunnel.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Public origin used to display/copy short links. If unset or localhost while
# the API is remote, the API origin is used automatically.
# EXPO_PUBLIC_SHORT_URL_BASE=https://linkflow.example.com

# ---------------------------------------------------------------------------
# Backend-only variables (never exposed to the mobile bundle)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/database
PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Developer API (Phase 2)
# ---------------------------------------------------------------------------
# Server-only: NEVER prefix these with EXPO_PUBLIC_.
#
# API_KEY_HASH_SECRET: dedicated secret used to derive the stored HMAC-SHA256
#   digest of every developer API key. Minimum 32 characters. Required: if it
#   is missing or too short, both key creation and `/api/v1/*` authentication
#   fail closed with 503 API_KEY_HASH_NOT_CONFIGURED. Generate one with e.g.
#   `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
#   Rotating this value invalidates every existing API key.
#
# Persistent keys are stored in PostgreSQL (`developer_api_keys`). In
# production DATABASE_URL is required: without it key management and API-key
# authentication fail closed with 503 DATABASE_NOT_CONFIGURED instead of
# falling back to non-durable memory.
#
# PUBLIC_SHORT_URL_BASE: public origin used to build `shortUrl` values in API
#   responses (e.g. https://linkflow.example.com). Falls back to
#   EXPO_PUBLIC_SHORT_URL_BASE, then to the request origin.
#
# API_KEY_HASH_SECRET=
# PUBLIC_SHORT_URL_BASE=https://linkflow.example.com

# ---------------------------------------------------------------------------
# Developer documentation and browser access (Phase 4)
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call the API
#   cross-origin. Native apps, curl and server-to-server calls send no Origin
#   header and are unaffected. If unset in production, no cross-origin browser
#   access is granted; same-origin or reverse-proxied deployments still work.
#   Development builds additionally allow the local Expo web ports.
#
# PUBLIC_APP_ORIGIN / EXPO_PUBLIC_APP_ORIGIN: optional single origin appended to
#   the allowlist, typically the documentation or dashboard host.
#
# Documentation artifacts are generated from the endpoint catalog:
#   npm run docs:generate
# and served read-only at /api/openapi.json, /api/postman/collection.json and
# /api/postman/environment.json.
#
# CORS_ALLOWED_ORIGINS=https://linkflow.example.com,https://www.linkflow.example.com
# PUBLIC_APP_ORIGIN=https://linkflow.example.com
