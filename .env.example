# ---------------------------------------------------------------------------
# LinkFlow URL environment example
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Never prefix a secret with EXPO_PUBLIC_: those values are bundled into the app.
# ---------------------------------------------------------------------------

# Clerk publishable key (client-safe). Required.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional explicit backend URL.
# Usually NOT needed in development: the app derives the API host from the Expo
# dev-server address (LAN IP for physical devices, 10.0.2.2 for Android
# emulators, localhost for iOS simulators and web).
# REQUIRED for production builds and whenever Expo runs with --tunnel.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Public origin used to display/copy short links. If unset or localhost while
# the API is remote, the API origin is used automatically.
# EXPO_PUBLIC_SHORT_URL_BASE=https://linkflow.example.com

# ---------------------------------------------------------------------------
# Backend-only variables (never exposed to the mobile bundle)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/database
PORT=3000
HOST=0.0.0.0
