{
  "info": {
    "name": "LinkFlow API",
    "description": "Import this collection, set the `apiKey` collection variable to a test key from the LinkFlow Developer Dashboard, and run any request.\n\nAuthentication uses the X-API-Key header. Never commit a real key to source control.\n\nQR scan analytics are not supported. QR analytics report linked-link clicks only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Links",
      "item": [
        {
          "name": "GET /api/v1/links — List links",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Response is JSON\", function () {",
                  "  pm.response.to.have.jsonBody();",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/links?limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "links"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Returns the authenticated developer's short links, newest first. Pagination is offset-based. The total field is the full number of links owned by the developer, not just the current page.\n\nRequired scope: links:read"
          },
          "response": [
            {
              "name": "200 List links",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-API-Key",
                    "value": "{{apiKey}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/links?limit=10&offset=0",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "links"
                  ],
                  "query": [
                    {
                      "key": "limit",
                      "value": "10"
                    },
                    {
                      "key": "offset",
                      "value": "0"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"Links retrieved successfully\",\n  \"data\": {\n    \"links\": [\n      {\n        \"id\": \"0e7c3a9e-2f4b-4a1f-9c55-1f0e6f6f3d21\",\n        \"originalUrl\": \"https://example.com/launch\",\n        \"shortUrl\": \"https://linkflowurl.com/launch\",\n        \"shortCode\": \"launch\",\n        \"customAlias\": \"launch\",\n        \"title\": \"Launch page\",\n        \"isActive\": true,\n        \"expiresAt\": null,\n        \"clicks\": 42,\n        \"createdAt\": \"2026-11-01T09:12:45.000Z\",\n        \"updatedAt\": \"2026-11-01T09:12:45.000Z\"\n      }\n    ],\n    \"total\": 42,\n    \"limit\": 10,\n    \"offset\": 0\n  }\n}"
            }
          ]
        },
